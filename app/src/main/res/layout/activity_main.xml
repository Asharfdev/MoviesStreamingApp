<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/background_dark"
            android:paddingEnd="16dp"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/text_primary"
            app:title="@string/app_name"
            app:titleCentered="false"
            app:titleTextColor="@color/text_primary" />

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="92dp" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_nav_background"
            app:elevation="12dp"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconSize="23dp"
            app:itemIconTint="@color/bottom_nav_color"
            app:itemPaddingBottom="12dp"
            app:itemPaddingTop="12dp"
            app:itemRippleColor="@color/accent_red"
            app:itemTextAppearanceActive="@style/BottomNavigationLabelActive"
            app:itemTextAppearanceInactive="@style/BottomNavigationLabelInactive"
            app:itemTextColor="@color/bottom_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/drawerNavigation"
        android:layout_width="312dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_dark"
        app:elevation="16dp"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/drawer_item_color"
        app:itemRippleColor="@color/accent_red"
        app:itemTextAppearance="@style/DrawerMenuItem"
        app:itemTextColor="@color/drawer_item_color"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
